# Environment Variables for LockIn App
# Copy this to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# Google Beta Form URL
VITE_GOOGLE_BETA_FORM_URL=https://forms.gle/your-form-id

# WhatsApp Group URL
VITE_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/your-group-id

# Google Sheets API Key (keep secret!)
VITE_GOOGLE_SHEETS_API_KEY=your-api-key-here

# Google Sheet ID (from the URL)
VITE_GOOGLE_SHEET_ID=1AVbGlCnjx7ImasgmM1gea8rksnfuRWyB1G3zxEotiZs

# Sheet GID (tab ID, from URL)
VITE_GOOGLE_SHEET_GID=1754224446

# Range to fetch (e.g., Sheet1!A:D for columns A to D)
VITE_GOOGLE_SHEET_RANGE=Sheet1!A:D

# Optional: Tally URL for additional tally view
VITE_TALLY_URL=https://tally.so/your-tally-link

# Social Links
VITE_X_URL=https://x.com/LockinApp_hq
VITE_TIKTOK_URL=https://www.tiktok.com/@LockinApp_hq